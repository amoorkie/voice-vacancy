# Секреты и локальная конфигурация не попадают в репозиторий.
.env
.env.*
!.env.example

# Артефакты разработки и зависимости воспроизводятся отдельно.
node_modules/
dist/
build/
coverage/
.next/
.venv/
__pycache__/
*.pyc
tmp/
.DS_Store
Thumbs.db

# Исходное задание и реальные аудиозаписи хранятся вне Git.
*.pdf
*.wav
*.mp3
*.m4a
*.webm
*.ogg

# Локальный runtime и результаты браузерных проверок.
.tools/
playwright-report/
test-results/
*.log
